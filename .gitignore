# ==========================================
# Prerequisites & Intermediate Build Artifacts
# ==========================================
# Dependency files generated by compilers (e.g. gcc -MMD)
*.d

# Compiled Object files
*.o
*.obj
*.ko
*.slo
*.lo

# Precompiled Headers
*.gch
*.pch

# ==========================================
# Static and Dynamic Libraries
# ==========================================
# Static libraries
*.a
*.lib
*.la
*.lai

# Shared libraries / Dynamic links
*.so
*.so.*
*.dylib
*.dll

# ==========================================
# Executables & Final Binaries
# ==========================================
*.exe
*.out
*.app
*.hex


# ==========================================
# Debugging & Information Files
# ==========================================
# Symbol files and memory dumps
*.pdb
*.ilk
*.idb
*.dwo
*.su
*.map
*.exp
*.stat
*.dSYM/

# Test output and internal caches
Testing/
.cache/

# ==========================================
# Build Systems & Directories
# ==========================================
# build directories
[Bb]uild/
build-*/
bin/

CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json

# ==========================================
# Package Managers & Text Editor Backups
# ==========================================
# vcpkg dependencies
vcpkg_installed/

# Temp files
*.tmp
*.log
*.bak
*.swp
*.~*

# ==========================================
# VS Code
# ==========================================
.vscode/

# ==========================================
# Personal
# ==========================================
[Nn]ote*/
*.note